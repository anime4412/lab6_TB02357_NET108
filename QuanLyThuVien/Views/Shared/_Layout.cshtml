<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư Viện Điện Tử (Lab 6 - NET108)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-warning" asp-controller="Home" asp-action="Index">
                    📚 Thư Viện Điện Tử (Lab 6)
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-bold" asp-controller="BorrowSlips" asp-action="Index">
                                <i class="bi bi-receipt"></i> Quản Lý Hóa Đơn / Phiếu Mượn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info fw-bold" asp-controller="Statistics" asp-action="Index">
                                <i class="bi bi-bar-chart-line"></i> Thống Kê &amp; Biểu Đồ
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3 text-light small">
                                <span>Xin chào: <strong>@User.Identity.Name</strong></span>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <span class="badge bg-danger ms-1"><i class="bi bi-shield-fill"></i> Quản lý (Admin)</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark ms-1"><i class="bi bi-person"></i> Thủ thư</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-box-arrow-right"></i> Đăng Xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container text-center">
            &copy; 2026 - <strong>Hệ Thống Quản Lý Thư Viện Điện Tử (Lab 6: Quản lý Hóa đơn/Phiếu mượn, Thống kê &amp; Chart.js - EF Core Code First)</strong> | Môn: <strong>NET108</strong> | Sinh viên: <strong>TB02357 (Nhóm 5)</strong>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
