@model QuanLyThuVien.Models.StatisticsViewModel

@{
    ViewData["Title"] = "Thống kê & Biểu đồ Chart.js - Lab 6";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-0"><i class="bi bi-bar-chart-line"></i> Thống Kê Kinh Doanh &amp; Biểu Đồ (Bài 2 &amp; Bài 3)</h2>
            <p class="text-muted small mb-0">Top 5 sách mượn nhiều nhất &amp; Doanh thu tùy chọn theo khoảng thời gian với <strong>Chart.js</strong></p>
        </div>
        <a asp-controller="BorrowSlips" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-receipt"></i> Xem Danh Sách Hóa Đơn
        </a>
    </div>

    <!-- FORM CHỌN KHOẢNG THỜI GIAN TÙY CHỌN -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Từ ngày:</label>
                    <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Đến ngày:</label>
                    <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 fw-bold">
                        <i class="bi bi-funnel"></i> Lọc Thống Kê
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Mặc định</a>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="small text-white-50">Tổng Doanh Thu Trong Kỳ</div>
                    <div class="fs-3 fw-bold">@Model.TotalRevenue.ToString("N0") VNĐ</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="small text-white-50">Tổng Số Hóa Đơn / Phiếu Mượn</div>
                    <div class="fs-3 fw-bold">@Model.TotalSlips đơn</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-info text-dark">
                <div class="card-body">
                    <div class="small">Tổng Lượt Mượn (Top 5 Sách)</div>
                    <div class="fs-3 fw-bold">@Model.TotalBooksBorrowed lượt</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BÀI 3: BIỂU ĐỒ CHART.JS -->
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-graph-up-arrow"></i> Biểu Đồ Doanh Thu Theo Ngày</h6>
                    <select id="chartTypeSelect" class="form-select form-select-sm" style="width: 150px;" onchange="changeRevenueChartType(this.value)">
                        <option value="bar" selected>Biểu đồ Cột (Bar)</option>
                        <option value="line">Biểu đồ Đường (Line)</option>
                    </select>
                </div>
                <div class="card-body">
                    <div style="width: 100%; margin: auto;">
                        <canvas id="myChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-success"><i class="bi bi-pie-chart"></i> Biểu Đồ Top 5 Sách Mượn Nhiều Nhất</h6>
                </div>
                <div class="card-body d-flex align-items-center">
                    <div style="width: 90%; margin: auto;">
                        <canvas id="topBooksChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU CHI TIẾT BÀI 2 -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    Top 5 Sách Được Mượn Nhiều Nhất (Từ @Model.FromDate.ToString("dd/MM/yyyy") đến @Model.ToDate.ToString("dd/MM/yyyy"))
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Hạng</th>
                                <th>Tên sách</th>
                                <th>Thể loại</th>
                                <th class="text-center">Số lượt mượn</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var item in Model.Top5Books)
                            {
                                <tr>
                                    <td><span class="badge bg-warning text-dark fw-bold">#@(rank++)</span></td>
                                    <td class="fw-bold">@item.BookTitle</td>
                                    <td><span class="badge bg-info text-dark">@item.CategoryName</span></td>
                                    <td class="text-center fw-bold text-primary">@item.TotalQuantity</td>
                                    <td class="text-end fw-bold text-danger">@item.TotalRevenue.ToString("N0") đ</td>
                                </tr>
                            }
                            @if (!Model.Top5Books.Any())
                            {
                                <tr><td colspan="5" class="text-center py-3 text-muted">Không có dữ liệu trong khoảng thời gian này.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    Bảng Doanh Thu Theo Ngày
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.RevenueByDates)
                            {
                                <tr>
                                    <td class="fw-bold">@d.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@d.SlipCount</td>
                                    <td class="text-end fw-bold text-danger">@d.Revenue.ToString("N0") đ</td>
                                </tr>
                            }
                            @if (!Model.RevenueByDates.Any())
                            {
                                <tr><td colspan="3" class="text-center py-3 text-muted">Chưa có doanh thu trong khoảng thời gian này.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Nhận dữ liệu từ ViewBag (Convert sang JSON để JS hiểu được)
        const labels = @Json.Serialize(ViewBag.Labels);
        const dataValues = @Json.Serialize(ViewBag.Values);

        const topBookLabels = @Json.Serialize(ViewBag.TopBookLabels);
        const topBookValues = @Json.Serialize(ViewBag.TopBookValues);

        // 1. Biểu đồ Doanh thu (#myChart)
        const ctx = document.getElementById('myChart').getContext('2d');
        let revenueChart = createRevenueChart('bar');

        function createRevenueChart(chartType) {
            return new Chart(ctx, {
                type: chartType,
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: dataValues,
                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: chartType === 'line'
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function changeRevenueChartType(newType) {
            revenueChart.destroy();
            revenueChart = createRevenueChart(newType);
        }

        // 2. Biểu đồ Top 5 Sách mượn nhiều nhất (#topBooksChart)
        const ctxTop = document.getElementById('topBooksChart').getContext('2d');
        new Chart(ctxTop, {
            type: 'doughnut',
            data: {
                labels: topBookLabels,
                datasets: [{
                    label: 'Số lượt mượn',
                    data: topBookValues,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(255, 206, 86, 0.7)',
                        'rgba(75, 192, 192, 0.7)',
                        'rgba(153, 102, 255, 0.7)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}
