@model QuanLyThuVien.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống - Lab 6";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold">ĐĂNG NHẬP QUẢN LÝ</h4>
                <small class="text-white-50">Môn NET108 - TB02357 - Nhóm 5</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="admin@thuvien.edu.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Mật khẩu..." />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng Nhập</button>
                </form>

                <hr class="my-3" />
                <div class="small text-muted">
                    <strong>Tài khoản Admin (Xem được Hóa đơn &amp; Thống kê):</strong><br />
                    Email: <code>admin@thuvien.edu.vn</code> | Pass: <code>Admin@123</code><br />
                    <span class="text-secondary">(Tài khoản Thủ thư: <code>thuthu@thuvien.edu.vn</code> / <code>Thuthu@123</code>)</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
