@model IEnumerable<QuanLyThuVien.Models.BorrowSlip>

@{
    ViewData["Title"] = "Quản lý hóa đơn / phiếu mượn - Lab 6";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-0"><i class="bi bi-receipt"></i> Danh Sách Tất Cả Hóa Đơn / Phiếu Mượn (Bài 1)</h2>
            <p class="text-muted small mb-0">Quản lý đơn hàng phía Quản lý — Môn NET108 | Sinh viên: TB02357 - Nhóm 5</p>
        </div>
        <a asp-controller="Statistics" asp-action="Index" class="btn btn-success shadow-sm">
            <i class="bi bi-bar-chart-line"></i> Xem Thống Kê &amp; Biểu Đồ
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Mã đơn</th>
                            <th>Độc giả</th>
                            <th>Nhân viên tạo đơn</th>
                            <th>Ngày tạo đơn</th>
                            <th class="text-center">Số đầu sách</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td><code class="fw-bold">@item.SlipCode</code></td>
                                <td>@(item.Reader?.FullName ?? "N/A")</td>
                                <td>@(item.Employee?.FullName ?? "Hệ thống")</td>
                                <td>@item.BorrowDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@item.BorrowDetails.Sum(d => d.Quantity) cuốn</span>
                                </td>
                                <td class="text-end text-danger fw-bold">@item.TotalAmount.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (item.Status == "Returned" || item.Status == "Paid")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "Borrowing")
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
